<%- include('../partials/encabezado') %>

<%- include('../partials/pasos-compra', { paso: 1 }) %>

<h1 class="titulo-pagina">Su carrito</h1>

<% if (lineas.length === 0) { %>
  <div class="vacio">
    <h2>Todavía no hay nada aquí</h2>
    <p>Explore el catálogo y agregue lo que le guste.</p>
    <p><a href="/" class="boton boton--primario">Ver productos</a></p>
  </div>
<% } else { %>
  <div class="carrito">
    <section aria-labelledby="titulo-lineas" class="carrito__lineas">
      <h2 id="titulo-lineas" class="visualmente-oculto">Productos en el carrito</h2>
      <ul class="lista-carrito">
        <% lineas.forEach(function (linea) { var p = linea.producto; %>
          <li class="linea-carrito">
            <img src="/img/<%= p.imagen %>" alt="" width="96" height="72" class="linea-carrito__imagen">
            <div class="linea-carrito__info">
              <h3><a href="/producto/<%= p.id %>"><%= p.nombre %></a></h3>
              <p class="linea-carrito__tienda"><%= tiendas[p.vendedorId].nombre %></p>
              <p><%= colones(p.precioFinal) %> c/u</p>
            </div>

            <form method="post" action="/carrito/actualizar" class="linea-carrito__cantidad">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="productoId" value="<%= p.id %>">
              <label for="cantidad-<%= p.id %>">Cantidad <span class="visualmente-oculto">de <%= p.nombre %></span></label>
              <div class="en-linea">
                <input id="cantidad-<%= p.id %>" name="cantidad" type="number" min="0" max="<%= Math.min(p.stock, maximo) %>" value="<%= linea.cantidad %>" inputmode="numeric" class="ancho-cantidad">
                <button type="submit" class="boton boton--secundario boton--pequeno">Actualizar<span class="visualmente-oculto"> cantidad de <%= p.nombre %></span></button>
              </div>
            </form>

            <p class="linea-carrito__total"><span class="visualmente-oculto">Total de esta línea: </span><%= colones(linea.totalLinea) %></p>

            <form method="post" action="/carrito/quitar" class="linea-carrito__quitar">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="productoId" value="<%= p.id %>">
              <button type="submit" class="enlace-boton enlace-boton--peligro">Quitar<span class="visualmente-oculto"> <%= p.nombre %></span></button>
            </form>
          </li>
        <% }) %>
      </ul>
    </section>

    <aside class="resumen" aria-labelledby="titulo-resumen-carrito">
      <h2 id="titulo-resumen-carrito">Resumen</h2>
      <dl class="desglose">
        <div><dt>Productos (IVA incluido)</dt><dd><%= colones(total) %></dd></div>
        <div><dt>Envío</dt><dd>Se calcula en el siguiente paso</dd></div>
      </dl>
      <a href="/checkout" class="boton boton--primario boton--ancho boton--grande">Continuar con la compra</a>
      <p class="resumen__nota">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        Si su carrito tiene productos de varias tiendas, cada una le envía su parte por separado.
      </p>
      <a href="/" class="enlace-volver">← Seguir comprando</a>
    </aside>
  </div>
<% } %>

<%- include('../partials/pie') %>
