<% if (flash && flash.length) { %>
  <div class="avisos">
    <% flash.forEach(function (aviso) { %>
      <div class="aviso aviso--<%= aviso.tipo %>" role="<%= aviso.tipo === 'error' ? 'alert' : 'status' %>">
        <% if (aviso.tipo === 'exito') { %>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="m7 12 3.5 3.5L17 9" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <% } else if (aviso.tipo === 'error') { %>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M12 7v6M12 16.5v.5" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/></svg>
        <% } else { %>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M12 11v6M12 7.5v.5" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/></svg>
        <% } %>
        <p><span class="visualmente-oculto"><%= aviso.tipo === 'error' ? 'Error: ' : aviso.tipo === 'exito' ? 'Listo: ' : 'Aviso: ' %></span><%= aviso.mensaje %></p>
      </div>
    <% }) %>
  </div>
<% } %>
