<!DOCTYPE html>
<html lang="es-CR"<%- clasesHtml ? ' class="' + clasesHtml + '"' : '' %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · MercaTico</title>
  <meta name="description" content="MercaTico: el marketplace de productos costarricenses, con pago protegido hasta la entrega.">
  <meta name="theme-color" content="#0f3d2e">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido principal</a>

  <header class="encabezado">
    <div class="contenedor encabezado__fila">
      <a href="/" class="marca">
        <svg class="marca__logo" viewBox="0 0 40 40" width="36" height="36" aria-hidden="true" focusable="false">
          <rect width="40" height="40" rx="10" fill="#f4c542"/>
          <path d="M9 28V13l11 9 11-9v15" fill="none" stroke="#0f3d2e" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Merca<strong>Tico</strong></span>
      </a>

      <form class="buscador" role="search" action="/" method="get">
        <label for="buscar" class="visualmente-oculto">Buscar productos</label>
        <input id="buscar" name="q" type="search" placeholder="Buscar café, chocolate, artesanía…"
               value="<%= locals.filtros ? filtros.q : '' %>" autocomplete="off" maxlength="80">
        <button type="submit" class="buscador__boton">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          <span class="visualmente-oculto">Buscar</span>
        </button>
      </form>

      <nav class="nav-principal" aria-label="Principal">
        <ul>
          <li><a href="/" <%- rutaActual === '/' ? 'aria-current="page"' : '' %>>Catálogo</a></li>
          <% if (usuario && usuario.rol === 'comprador') { %>
            <li><a href="/ordenes" <%- rutaActual.startsWith('/ordenes') ? 'aria-current="page"' : '' %>>Mis pedidos</a></li>
          <% } %>
          <% if (usuario && usuario.rol === 'vendedor') { %>
            <li><a href="/vendedor" <%- rutaActual === '/vendedor' ? 'aria-current="page"' : '' %>>Mi tienda</a></li>
          <% } %>
          <% if (usuario && usuario.rol === 'admin') { %>
            <li><a href="/admin" <%- rutaActual === '/admin' ? 'aria-current="page"' : '' %>>Administración</a></li>
          <% } %>
          <% if (usuario) { %>
            <li>
              <a href="/notificaciones" class="nav-icono" <%- rutaActual === '/notificaciones' ? 'aria-current="page"' : '' %>>
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M6 16V11a6 6 0 1 1 12 0v5l2 2H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M10 20a2 2 0 0 0 4 0" fill="none" stroke="currentColor" stroke-width="2"/></svg>
                <span class="nav-icono__texto">Avisos</span>
                <% if (notificacionesNoLeidas > 0) { %>
                  <span class="insignia"><%= notificacionesNoLeidas %><span class="visualmente-oculto"> sin leer</span></span>
                <% } %>
              </a>
            </li>
          <% } %>
          <li>
            <a href="/carrito" class="nav-icono" <%- rutaActual === '/carrito' ? 'aria-current="page"' : '' %>>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M3 4h2l2.4 11h10.2L20 8H6.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="19.5" r="1.5" fill="currentColor"/><circle cx="17" cy="19.5" r="1.5" fill="currentColor"/></svg>
              <span class="nav-icono__texto">Carrito</span>
              <span class="insignia" data-carrito-cantidad <%- carritoCantidad === 0 ? 'hidden' : '' %>><%= carritoCantidad %></span><span class="visualmente-oculto" data-carrito-texto>, <%= carritoCantidad %> <%= carritoCantidad === 1 ? 'artículo' : 'artículos' %></span>
            </a>
          </li>
          <% if (usuario) { %>
            <li class="nav-principal__sesion">
              <span class="nav-principal__usuario" title="<%= usuario.nombre %>"><%= usuario.primerNombre %></span>
              <form action="/logout" method="post">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button type="submit" class="enlace-boton">Salir</button>
              </form>
            </li>
          <% } else { %>
            <li><a href="/login" class="boton boton--claro boton--pequeno">Ingresar</a></li>
          <% } %>
        </ul>
      </nav>
    </div>
  </header>

  <main id="contenido" tabindex="-1">
    <div class="contenedor">
      <%- include('flash') %>
